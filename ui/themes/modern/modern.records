# Schemify "Modern Dark" (id `modern`): the default theme. A records-only theme (config spec §5
# Themes) bundled with the editor; `schemify.opt.theme = "xschem"` (View → Classic theme)
# switches to the default UI alone. It restyles; nodes, keys and accelerators are untouched
# (D25). Selectors `X.light` lay the light variant over `X` while the canvas is light.

# --- ui-shell (area A): tokens, the mockup's CSS variables -----------------------------------------

color chrome 1d1f24
color chrome2 24272d
color canvas 16181c
color line 2c2f36
color line2 3a3e46
color text d0d3d8
color dim 8a909a
color faint 5d626b
color blue 4ea3e0
color wire 4f8fc9
color sym 8fb84a
color pin e5534b
color sel 2c4a80
color acc 3d7be0
color ok 5fbf6a
color bad e06c66
color input 121418
color row-on 2a2d33
# A filled button with white text: @acc darkened to 4.65:1 (white on 3d7be0 is 4.11:1).
color acc-fill 3672d4

# The names the other sections were written with, mapped onto the mockup's.
color bg 16181c
color surface 1d1f24
color raised 24272d
color hover 2a2d33
color active 2f343c
color text-2 c5c9d0
color muted 8a909a
color bright ffffff
color accent-bg 2c4a80
color accent-fg 4ea3e0
color error e06c66

# --- ui-shell: chrome (menu bar, toolbar, tabs, view switch, status bar) ----------------------

style *
  fg @text
  accel-fg @dim
  hover-bg @row-on
  active-bg @active
  border-color @line2

style window
  bg @canvas

style menubar
  bg @chrome
  height 26
  pad 9
  gap 0

style menu-title
  pad 7
  hover-bg @row-on
  active-bg @row-on

style menubar-dash
  fg @faint

style menubar-button
  bg @chrome
  hover-bg @row-on
  pad 4

style menu
  bg @chrome2
  border-color @line2

style item
  hover-bg @sel

style separator
  fg @line2

style toolbar
  bg @chrome
  height 30
  pad 6
  gap 5

style button
  hover-bg @row-on
  radius 4

style tabs
  bg @chrome
  height 22
  pad 2
  gap 2

style tab
  bg @chrome2
  fg @dim
  active-bg @row-on
  active-fg @text
  hover-bg @row-on
  border 0
  radius 0
  pad 6
  height 21

style tab-new
  bg @chrome
  fg @dim
  border 0
  radius 0
  pad 6
  height 21

style canvas
  bg @canvas

style status
  bg @chrome
  height 24
  pad 6
  gap 8

style status-field
  bg @input
  border-color @line2
  width 46
  font 12

style status-right
  fg @dim
  font 12

style status-staged
  fg @ok
  font 12

style text_input
  bg @input
  border-color @line2

style text_area
  bg @input
  border-color @line2

style dialog
  bg @chrome2
  border-color @line2
  radius 6

style dialog-button
  bg @active
  hover-bg @line2
  radius 4

style ctx-menu
  bg @chrome2
  border-color @line2

style list-row
  hover-bg @row-on
  active-bg @row-on
  active-fg @bright

style keys-panel
  bg @chrome2

style view-switch
  bg @chrome2
  border-color @line2
  radius 0
  pad 0
  pad-y 0
  gap 0

style viewsw
  bg @chrome2
  fg @dim
  hover-bg @row-on
  hover-fg @text
  radius 0
  pad 11
  height 22
  font 12

style viewsw-on
  bg @sel
  fg @bright
  hover-bg @sel
  radius 0
  pad 11
  height 22
  font 12

style viewsw-off
  fg 4a4f57
  hover-bg @chrome2
  radius 0
  pad 11
  height 22
  font 12

# --- end ui-shell chrome ---

