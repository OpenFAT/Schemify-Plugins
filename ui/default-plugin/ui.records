# Schemify default UI: the xschem-parity shell (D6, D25).
#
# Body of the bundled default-UI plugin's `contribute ui` set (plugin-abi §7, format spec §2);
# its key bindings are the `contribute keymap` set in keymap.records. Every element below can be
# overridden by a later plugin with `set`, `remove` or `style` records; last contribution wins (D8).
# Menus, items and accelerators follow xschem 3.4.7's menus (captured live).

# --- theme: one row per selector; class (`style` prop) > kind > `*` -----------------------------

style *
  fg 000000
  font 13
  accel-fg 000000
  hover-bg ececec
  active-bg c3c3c3
  border-color 808080

style window
  bg 000000
  dir column

style menubar
  bg d9d9d9
  dir row
  height 27
  pad 2

style menu-title
  pad 7
  height 23
  hover-bg ececec
  active-bg ececec

style menubar-dash
  fg 6d6d6d
  pad 7

style menubar-button
  bg a3a3a3
  hover-bg b8b8b8
  pad 6
  height 23

style menu
  bg d9d9d9
  border 1
  border-color 8c8c8c
  pad-y 2
  min-width 140

style item
  pad 6
  height 22
  gap 28
  hover-bg ececec

style radio
  radius 6

style separator
  height 9
  fg a3a3a3

style toolbar
  bg ffffff
  dir row
  height 30
  pad 3
  gap 2

style button
  pad 5
  height 24
  font 12
  hover-bg dcdcdc
  radius 3

style spacer
  grow 1

style tabs
  bg c3c3c3
  dir row
  height 23
  pad 1
  gap 2

style tab
  bg d9d9d9
  pad 5
  height 20
  border 1
  active-bg 90ee90

style tab-new
  bg d9d9d9
  pad 4
  height 18
  border 1

style canvas
  grow 1
  bg 000000

style work
  dir row
  hover-bg 3874d8
  grow 1
  stretch 1

style docs-pane
  bg ffffff
  dir column
  width 560
  border 1
  border-color a0a0a0

style docs-bar
  bg e8e8e8
  dir row
  height 28
  pad 3
  gap 2

style docs-title
  pad 6

style docs-page
  grow 1
  dir column
  pad 16
  pad-y 12
  gap 4

style docs-block
  dir column
  pad 4
  pad-y 2

style docs-block-sel
  dir column
  pad 4
  pad-y 2
  bg e8f0ff

style prose
  font 15
  fg 202020

style docs-var
  dir row
  gap 6
  pad 4
  pad-y 3
  bg f4f4f4

style docs-var-name
  fg 1a3a8a
  font 14

style docs-expr
  bg ffffff
  border 1
  border-color d0d0d0
  width 200
  grow 1

style docs-value
  fg 006000
  font 14

style docs-value-bad
  fg c00000
  font 14

style docs-unverified
  fg b06000
  font 11

style docs-hint
  fg 707070
  font 12

style docs-plot
  bg 101010
  fg c0c0c0
  dir column
  height 110
  pad 8
  pad-y 6
  gap 4

style docs-graph
  height 170

style docs-staged-bar
  dir row
  gap 6
  pad 6
  pad-y 4
  bg e6ffe6
  border 1
  border-color 40a040

style docs-staged
  fg 107010
  font 13

style docs-toggle
  border 1
  border-color b0b0b0

style docs-toggle-on
  bg c3c3c3
  hover-bg c3c3c3
  border 1
  border-color 808080

style docs-preview-cap
  fg 707070
  font 11
  pad-y 2

style docs-preview
  bg fbfbfb
  border 1
  border-color d8d8d8
  pad 8
  pad-y 6

style docs-source
  font 14
  border 1
  border-color d0d0d0
  pad 4
  pad-y 2

# --- docks: the left icon bar, and the left, right and bottom docks
# around the canvas. The app shows a pane's content (`<id>.pane`, class dock-pane) in its dock
# under a header (dock-bar, dock-title, dock-button) and removes a hidden dock.

style body
  dir row
  grow 1
  stretch 1

style activity
  bg d9d9d9
  dir column
  width 44
  pad 0
  pad-y 4
  gap 0

style activity-button
  pad 12
  height 40
  width 44
  hover-bg ececec
  active-bg c3c3c3
  radius 0
  mark 2

style dock-hsplit
  bg a0a0a0
  hover-bg 3874d8
  dir row
  grow 1
  stretch 1

style dock-vsplit
  bg a0a0a0
  hover-bg 3874d8
  dir column
  grow 1

style center
  dir column
  grow 1

style dock
  bg f4f4f4
  dir column

style dock-bar
  bg e0e0e0
  dir row
  height 26
  pad 3
  gap 4

style dock-title
  pad 4
  font 12

style dock-button
  pad 5
  height 20
  hover-bg cfcfcf
  radius 3

style dock-pane
  bg f4f4f4
  dir column
  grow 1

style dock-note
  fg 555555
  pad 8
  pad-y 8

# ui-shell (area A): the bottom dock's tabs, and the rows of the Explorer, Search, Source
# control and Account panes (a tree row, a dim row, a right-hand marker, a section header).
style dock-tab
  pad 6
  height 20
  font 12
  hover-bg cfcfcf
  active-bg f4f4f4

style tree-row
  pad 6
  height 23
  hover-bg ececec
  active-bg c3c3c3

style tree-dim
  fg 555555
  pad 6
  height 23
  hover-bg ececec

style tree-line
  dir row
  gap 0

style tree-fill
  pad 6
  height 23
  grow 1
  hover-bg ececec
  active-bg c3c3c3

style search-input
  width 216

style tree-indent
  pad 2
  height 23

style tree-arrow
  pad 0
  width 16
  height 23

style tree-mark
  fg 555555
  font 11
  pad 10
  height 23

style tree-section
  fg 555555
  font 11
  pad 12
  pad-y 4
  height 34

style scm-mark
  fg 555555
  font 11
  pad 10
  height 23
# --- end ui-shell dock rows ---

# ===== ui-chat: the agent chat (the `agent` pane; chat spec) =====
# Layout and the classic (light) colours; the Modern theme recolours the same classes. The consent
# buttons inside are core-owned (`core.chat`, `core.chat-primary`); everything else a theme restyles.
