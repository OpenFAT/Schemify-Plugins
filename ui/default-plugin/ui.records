# View switcher floating over the canvas (a child of `canvas`): the app sets each button's
# style to viewsw-on (shown), viewsw (available) or viewsw-off (the file kind lacks it, disabled).
style view-switch
  bg d9d9d9
  dir row
  pad 2
  pad-y 2
  gap 2
  border 1
  border-color 808080
  radius 4

style viewsw
  bg d9d9d9
  pad 10
  height 22
  font 12
  hover-bg f4f4f4
  radius 3

style viewsw-on
  bg ffffff
  pad 10
  height 22
  font 12
  hover-bg ffffff
  radius 3

style viewsw-off
  fg 9a9a9a
  pad 10
  height 22
  font 12
  hover-bg d9d9d9
  radius 3

# --- window ---------------------------------------------------------------------------------------

node window window

node menubar menubar
  parent window

# --- menus (generated once from xschem 3.4.7's live menu tree, then hand-maintained) ----------------

node menu.file menu
  parent menubar
  label File
node file.clear_schematic item
  parent menu.file
  label "Clear Schematic"
  command file.clear_schematic
  accel Ctrl+N
node file.clear_symbol item
  parent menu.file
  label "Clear Symbol"
  command file.clear_symbol
  accel Ctrl+Shift+N
node file.component_browser item
  parent menu.file
  label "Component browser"
  command file.component_browser
  accel "Shift-Ins, Ctrl-I"
node file.open item
  parent menu.file
  label Open
  command file.open
  accel Ctrl+O
node file.open_most_recent item
  parent menu.file
  label "Open Most Recent"
  command file.open_most_recent
  accel Ctrl+Shift+O
node menu.file.open_recent menu
  parent menu.file
  label "Open recent"
node file.create_new_window_tab item
  parent menu.file
  label "Create new window/tab"
  command file.create_new_window_tab
node file.open_schematic_in_new_window_tab item
  parent menu.file
  label "Open schematic in new window/tab"
  command edit.open_sub_schematic_tab
  accel Alt+E
node file.open_symbol_in_new_window_tab item
  parent menu.file
  label "Open symbol in new window/tab"
  command edit.open_symbol_tab
  accel Alt+I
node file.delete_files item
  parent menu.file
  label "Delete files"
  command file.delete_files
  accel Shift-D
node file.save item
  parent menu.file
  label Save
  command file.save
  accel Ctrl+S
node file.merge item
  parent menu.file
  label Merge
  command file.merge
  accel B
node file.reload item
  parent menu.file
  label Reload
  command file.reload
  accel Alt+S
node file.save_as item
  parent menu.file
  label "Save as"
  command file.save_as
  accel Ctrl+Shift+S
node file.save_as_symbol item
  parent menu.file
  label "Save as symbol"
  command file.save_as_symbol
  accel Ctrl+Alt+S
node menu.file.image_export menu
  parent menu.file
  label "Image export"
node file.image_export.eps_selection_export item
  parent menu.file.image_export
  label "EPS Selection Export"
  command file.image_export.eps_selection_export
node file.image_export.pdf_ps_export item
  parent menu.file.image_export
  label "PDF/PS Export"
  command file.image_export.pdf_ps_export
  accel *
node file.image_export.pdf_ps_export_full item
  parent menu.file.image_export
  label "PDF/PS Export Full"
  command file.image_export.pdf_ps_export_full
node file.image_export.hierarchical_pdf_ps_export item
  parent menu.file.image_export
  label "Hierarchical PDF/PS Export"
  command file.image_export.hierarchical_pdf_ps_export
node file.image_export.png_export item
  parent menu.file.image_export
  label "PNG Export"
  command file.image_export.png_export
  accel Ctrl+*
node file.image_export.svg_export item
  parent menu.file.image_export
  label "SVG Export"
  command file.image_export.svg_export
  accel Alt+*
node file.export_cdl item
  parent menu.file
  label "Export CDL netlist…"
  command file.export_cdl
  tooltip "Write the cell's CDL netlist to .schemify/netlist/ (the simulator dialect stays)"
node file.export_project item
  parent menu.file
  label "Export project (zip)"
  command file.export_project
node file.import_project item
  parent menu.file
  label "Import project (zip)"
  command file.import_project
node file.import_project.folder item
  parent menu.file
  label "Import project folder"
  command file.import_project.folder
node menu.file.sep1 separator
  parent menu.file
node file.close_schematic item
  parent menu.file
  label "Close schematic"
  command file.close_schematic
  accel Ctrl+W
node file.quit item
  parent menu.file
  label Quit
  command file.quit
  accel Ctrl+Q
node menu.edit menu
