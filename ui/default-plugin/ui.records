# --- toolbar: vector icons (the `icon` prop); labels stay the accessible names ---------------------

node toolbar toolbar
  parent window
node tb.open button
  parent toolbar
  label Open
  command file.open
  icon "M1.5 4 L6 4 L7.5 5.5 L14.5 5.5 L14.5 13.5 L1.5 13.5 Z"
  tooltip "Open file"
node tb.save button
  parent toolbar
  label Save
  command file.save
  icon "M2 2 L12 2 L14 4 L14 14 L2 14 Z M5 2 L5 6 L11 6 L11 2 M5 14 L5 10 L11 10 L11 14"
node tb.reload button
  parent toolbar
  label Reload
  command file.reload
  icon "M13.5 8 C13.5 11 11 13.5 8 13.5 C5 13.5 2.5 11 2.5 8 C2.5 5 5 2.5 8 2.5 C10 2.5 11.6 3.5 12.6 5 M13 1.5 L13 5.5 L9 5.5"
node tb.undo button
  parent toolbar
  label Undo
  command edit.undo
  icon "M5.5 3 L2 6.5 L5.5 10 M2 6.5 L10 6.5 C12.5 6.5 14 8.3 14 10.5 C14 12.7 12.5 14 10 14 L7 14"
node tb.redo button
  parent toolbar
  label Redo
  command edit.redo
  icon "M10.5 3 L14 6.5 L10.5 10 M14 6.5 L6 6.5 C3.5 6.5 2 8.3 2 10.5 C2 12.7 3.5 14 6 14 L9 14"
node tb.cut button
  parent toolbar
  label Cut
  command edit.cut
  icon "M6.5 12 C6.5 13.1 5.6 14 4.5 14 C3.4 14 2.5 13.1 2.5 12 C2.5 10.9 3.4 10 4.5 10 C5.6 10 6.5 10.9 6.5 12 Z M13.5 12 C13.5 13.1 12.6 14 11.5 14 C10.4 14 9.5 13.1 9.5 12 C9.5 10.9 10.4 10 11.5 10 C12.6 10 13.5 10.9 13.5 12 Z M5.8 10.4 L12 1.5 M10.2 10.4 L4 1.5"
node tb.copy button
  parent toolbar
  label Copy
  command edit.copy
  icon "M5.5 5.5 L14 5.5 L14 14 L5.5 14 Z M10.5 5.5 L10.5 2 L2 2 L2 10.5 L5.5 10.5"
node tb.paste button
  parent toolbar
  label Paste
  command edit.paste
  icon "M3 3 L13 3 L13 15 L3 15 Z M6 1.5 L10 1.5 L10 4.5 L6 4.5 Z M5.5 8 L10.5 8 M5.5 11 L10.5 11"
node tb.delete button
  parent toolbar
